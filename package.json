{
  "name": "tuhoctaichinh",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/generate-lesson-data.mjs && node scripts/build-translation-index.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/generate-lesson-data.mjs && node scripts/build-translation-index.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "//prepare": "Trỏ git vào .githooks (xem .githooks/pre-push). Chạy tự động sau `npm install`; `|| true` để một bản checkout không phải kho git vẫn cài được.",
    "prepare": "git config core.hooksPath .githooks || true",
    "//pretest": "13 bộ kiểm đọc lib/lessons-data, thư mục do generate-lesson-data.mjs sinh ra và nằm trong .gitignore. Không có bước này thì `npm test` trên một bản checkout sạch - tức là mọi lượt chạy CI - fail 13 tệp vì thiếu tệp, không phải vì lỗi. Mất khoảng 2 giây.",
    "pretest": "node scripts/generate-lesson-data.mjs && node scripts/build-translation-index.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:migrations": "node scripts/check-migrations.mjs",
    "audit:lessons": "node scripts/generate-lesson-data.mjs && node scripts/audit-lesson-content.mjs",
    "audit:lessons:en": "node scripts/generate-lesson-data.mjs && node scripts/build-translation-index.mjs && node scripts/audit-lesson-content.mjs --locale=en"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.2",
    "@react-three/fiber": "^9.7.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.43.4",
    "@types/katex": "^0.16.8",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.42.2",
    "katex": "^0.17.0",
    "livekit-client": "^2.21.0",
    "livekit-server-sdk": "^2.17.0",
    "lucide-react": "^1.22.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.9.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "three": "^0.185.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.3",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
