# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/

# next.js
/.next/
/out/

# generated from lib/lessons.ts by scripts/generate-lesson-data.mjs
# (predev/prebuild) - not a source of truth, don't hand-edit or commit
/lib/lessons-data/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
pics/

# Cloudflare Workers (adapter OpenNext) - thư mục build, sinh lại được
.open-next/
.wrangler/

# Dữ liệu xuất từ Supabase phục vụ di trú D1: 25 MB và chứa dữ liệu cá nhân thật
# (email, tên, nội dung tin nhắn của 3.652 người dùng). Tái tạo được bất cứ lúc
# nào bằng `node scripts/d1/export.mjs`, nên không có lý do gì để nó nằm trong git.
scripts/d1/data/
scripts/d1/sql/
