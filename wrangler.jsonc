{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "tu-hoc-cong-nghe",
	// worker.ts bọc worker của OpenNext để thêm /realtime/* (Durable Objects).
	// Phải chạy `opennextjs-cloudflare build` trước: worker.ts import
	// .open-next/worker.js do bước đó sinh ra.
	"main": "worker.ts",
	"compatibility_date": "2026-08-22",
	// nodejs_compat: adapter OpenNext cần các API Node mà Next dựa vào.
	// global_fetch_strictly_public: fetch() tới chính tên miền của Worker đi ra
	// Internet rồi quay lại, thay vì bị nối tắt trong máy - giữ hành vi giống
	// môi trường chạy thật của Next.
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// GIAI ĐOẠN 1: chưa gắn D1 hay R2. Bước này chỉ chứng minh ứng dụng chạy
	// được trên Workers trong khi VẪN đọc Cloudflare. Gắn kho dữ liệu là giai
	// đoạn 4, sau khi lớp kho dữ liệu và bộ kiểm phân quyền đã xong.
	//
	"durable_objects": {
		"bindings": [{ "name": "REALTIME", "class_name": "RealtimeHub" }]
	},
	// Cú pháp khai báo `exports` (thay mảng `migrations` từ 06/2026). Namespace
	// được cấp ở lần deploy đầu. ĐỔI TÊN hay XOÁ lớp này phải dùng trạng thái
	// tombstone - xoá dòng này đi là xoá namespace, kèm mọi presence đang sống.
	"exports": {
		"RealtimeHub": { "type": "durable-object", "storage": "sqlite" }
	},
	// Workers AI - bộ não của chatbot Cơ Cơ (app/api/coco-chat/route.ts). Thiếu
	// binding (chạy `next dev` không qua worker) thì route tự rơi về chế độ gợi
	// ý bài học, không báo lỗi.
	"ai": { "binding": "AI" },
	"r2_buckets": [{ "binding": "FILES", "bucket_name": "thcn-files" }],
	// "kv_namespaces":[{ "binding": "SESSIONS", "id": "<điền sau>" }],
	"vars": {
		"NEXT_PUBLIC_SITE_URL": "https://tuhoccongnghe.org"
		// GOOGLE_CLIENT_ID và GOOGLE_CLIENT_SECRET là secret (`wrangler secret put`),
		// không khai ở đây: một var trùng tên với secret làm deploy báo lỗi.
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "tu-hoc-cong-nghe",
			"database_id": "b2fbf614-dfed-4fff-a01b-315afa79f4e4"
		}
	]
}