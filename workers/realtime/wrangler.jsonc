{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "thcn-realtime",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-22",
	"compatibility_flags": ["nodejs_compat"],
	// Worker RIÊNG, không đi qua OpenNext. .open-next/worker.js được sinh lại
	// mỗi lần build và không có chỗ để chèn một class Durable Object tuỳ biến
	// vào cùng bundle - xem ghi chú trong src/index.ts. App chính gọi sang đây
	// bằng service binding (khai trong wrangler.jsonc gốc), trình duyệt thì
	// nối WebSocket trực tiếp vào domain của worker này.
	"durable_objects": {
		"bindings": [{ "name": "TOPIC_ROOM", "class_name": "TopicRoom" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["TopicRoom"] }]
}
