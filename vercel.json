{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": false,
      "**": false
    }
  },
  "crons": [
    { "path": "/api/cron/send-reminders", "schedule": "0 12 * * *" },
    { "path": "/api/cron/morning-review", "schedule": "30 0 * * *" },
    { "path": "/api/cron/send-weekly-digest", "schedule": "0 12 * * 1" },
    { "path": "/api/cron/send-streak-milestones", "schedule": "30 12 * * *" },
    { "path": "/api/cron/weekly-study-match", "schedule": "0 13 * * 1" },
    { "path": "/api/cron/daily-study-group-update", "schedule": "0 14 * * *" }
  ]
}
